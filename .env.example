# Copy to .env.local for development. Add real values in Vercel settings.
# Never put real credentials in this example.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_EMAIL=
# Use literal \n between private-key lines when storing as a single line.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Generate an independent random secret of at least 32 bytes.
SHEETS_CONFIRMATION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELEGRAM_BOT_TOKEN=
TG_ADMIN_GROUP_ID=
TG_TOPIC_NEW_ORDER=
TG_TOPIC_RETURN=
TG_TOPIC_ERROR=
TG_TOPIC_PENDING_REVIEW=
CRON_SECRET=
# Optional build-time token for uploading Sentry source maps.
SENTRY_AUTH_TOKEN=
